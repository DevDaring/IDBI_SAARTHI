# ── secrets: never commit ──────────────────────────────────────────
.env
*/.env
Codes/.env
saarthi/backend/.env
kaggle.json
*.pem
*token*
*secret*

# ── confidential: IDBI NDA, API catalogue, personal details ────────
IDBI_Documents/

# ── data: 15 GB of public corpora, re-downloadable ─────────────────
Dataset/

# ── environments / caches ──────────────────────────────────────────
.venv/
__pycache__/
*.pyc
node_modules/
.vite/

# ── large model binaries (published to HuggingFace instead) ────────
*.joblib
*.pt
*.bin
*.safetensors
*.pkl

# ── app runtime ────────────────────────────────────────────────────
saarthi/backend/uploads/*
!saarthi/backend/uploads/.gitkeep
saarthi/frontend/dist/
saarthi/data/*.csv
*.log
.DS_Store

# submission deck kept local, not published
Final_Submission/
